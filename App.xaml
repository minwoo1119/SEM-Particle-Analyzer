<Application x:Class="SemParticleAnalyzer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="Views/MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#202020"/>
  <SolidColorBrush x:Key="Muted" Color="#666666"/>
  <SolidColorBrush x:Key="Line" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="Panel" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="5,3"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,12"/>
   <Setter Property="Padding" Value="10"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="MaxWidth" Value="360"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Background" Value="#FFFDFD"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#B9BEC3"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="ViewerToolButton" TargetType="ToggleButton">
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
   <Style.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Background" Value="#CCE4F7"/>
     <Setter Property="BorderBrush" Value="#0078D4"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ViewerIconButton" TargetType="Button">
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
  </Style>
 </Application.Resources>
</Application>
