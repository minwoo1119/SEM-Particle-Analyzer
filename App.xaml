<Application x:Class="SemParticleAnalyzer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="Views/MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#202428"/>
  <SolidColorBrush x:Key="Muted" Color="#697077"/>
  <SolidColorBrush x:Key="Line" Color="#D9DDE1"/>
  <SolidColorBrush x:Key="Panel" Color="#F6F7F8"/>
  <SolidColorBrush x:Key="Accent" Color="#374B5A"/>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#ECEFF1"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,12"/>
   <Setter Property="Padding" Value="10"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="MaxWidth" Value="360"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Background" Value="#FFFDFD"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#B9BEC3"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
 </Application.Resources>
</Application>
