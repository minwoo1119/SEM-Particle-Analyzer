<Window x:Class="SemParticleAnalyzer.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:SemParticleAnalyzer.Controls"
 Title="SEM Particle Analyzer" Width="1500" Height="920" MinWidth="1120" MinHeight="700"
 WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition/>
   <RowDefinition Height="32"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Command="{Binding LoadPresetCommand}" ToolTip="저장해 둔 analysis_settings.json을 불러와 분석 조건을 복원합니다.">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,0,7,0"/><TextBlock Text="설정 불러오기"/></StackPanel>
     </Button>
     <Button Command="{Binding SavePresetCommand}" ToolTip="현재 ROI, 전처리, Threshold, 필터 및 보정 조건을 JSON으로 저장합니다.">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,0,7,0"/><TextBlock Text="설정 저장"/></StackPanel>
     </Button>
     <Button Command="{Binding ExportCommand}" ToolTip="원본 해상도로 다시 분석한 뒤 이미지, CSV, JSON, HTML 보고서를 결과 폴더에 저장합니다.">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDE1;" Margin="0,0,7,0"/><TextBlock Text="결과 저장"/></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Button Command="{Binding OpenImageCommand}" ToolTip="PNG, JPEG, BMP, TIFF 이미지를 엽니다. 원본 파일은 수정하지 않습니다.">
      <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" Margin="0,0,7,0"/><TextBlock Text="이미지 열기"/></StackPanel>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="332"/>
   </Grid.ColumnDefinitions>
   <Grid.RowDefinitions>
    <RowDefinition Height="2.2*"/>
    <RowDefinition Height="1*"/>
   </Grid.RowDefinitions>

   <Border Grid.Column="0" Grid.Row="0" Margin="12,12,6,6" Background="#17191B" BorderBrush="#C9CDD1" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Text="{Binding ImageDescription}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
       <ComboBox ItemsSource="{Binding ViewerModes}" SelectedItem="{Binding ViewerMode}" Width="140"
        ToolTip="Original: 원본&#x0a;Preprocessed: 전처리 결과&#x0a;BinaryMask: 분할 마스크&#x0a;Overlay: 통과/제외 객체 윤곽과 ID"/>
       <Separator Margin="8,0"/>
       <ToggleButton x:Name="SelectRoiToolButton" IsChecked="True"
        Style="{StaticResource ViewerToolButton}" Click="SelectRoiToolButton_OnClick"
        ToolTip="선택 / ROI: 짧게 클릭하면 검출 객체를 선택하고, 드래그하면 분석 ROI를 지정합니다.">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C8;" FontSize="15"/>
       </ToggleButton>
       <ToggleButton x:Name="PanToolButton"
        Style="{StaticResource ViewerToolButton}" Click="PanToolButton_OnClick"
        ToolTip="이동: 확대된 이미지를 드래그하여 이동합니다.">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C2;" FontSize="15"/>
       </ToggleButton>
       <ToggleButton x:Name="ZoomAreaToolButton"
        Style="{StaticResource ViewerToolButton}" Click="ZoomAreaToolButton_OnClick"
        ToolTip="영역 확대: 확대할 사각 영역을 드래그합니다.">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE1A3;" FontSize="15"/>
       </ToggleButton>
       <Separator Margin="5,0"/>
       <Button Click="ZoomOut_OnClick" Style="{StaticResource ViewerIconButton}" ToolTip="축소">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71F;" FontSize="15"/>
       </Button>
       <Button Click="ZoomIn_OnClick" Style="{StaticResource ViewerIconButton}" ToolTip="확대">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A3;" FontSize="15"/>
       </Button>
       <Button Click="Fit_OnClick" Style="{StaticResource ViewerIconButton}" ToolTip="화면 맞춤">
        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9A6;" FontSize="15"/>
       </Button>
       <Button Click="ActualSize_OnClick" Style="{StaticResource ViewerIconButton}" ToolTip="실제 크기(1:1)">
        <TextBlock Text="1:1" FontSize="10" FontWeight="SemiBold"/>
       </Button>
      </DockPanel>
     </Border>
     <Border x:Name="ImageHost" Grid.Row="1" Background="#17191B"
      SizeChanged="ImageHost_OnSizeChanged"
      MouseWheel="ImageHost_OnMouseWheel"
      MouseLeftButtonDown="ImageHost_OnMouseLeftButtonDown"
      MouseMove="ImageHost_OnMouseMove"
      MouseLeftButtonUp="ImageHost_OnMouseLeftButtonUp">
      <Grid ClipToBounds="True">
       <Grid x:Name="ViewportContent" IsHitTestVisible="False" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
         <TransformGroup>
          <ScaleTransform x:Name="ViewerScaleTransform" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="ViewerTranslateTransform"/>
         </TransformGroup>
        </Grid.RenderTransform>
        <Image Source="{Binding DisplayImage}" Stretch="Uniform" SnapsToDevicePixels="True"/>
        <Canvas x:Name="RoiCanvas">
         <Rectangle x:Name="RoiRectangle" Stroke="#FFD54F" StrokeThickness="2.5"
          StrokeDashArray="6,3" Fill="#16FFD54F" Visibility="Collapsed"/>
         <Polygon x:Name="SelectionContour" Stroke="#00E5FF" StrokeThickness="1.5"
          StrokeLineJoin="Round" Fill="#2200E5FF" Visibility="Collapsed"/>
         <Rectangle x:Name="ZoomAreaRectangle" Stroke="#FFFFFF" StrokeThickness="2"
          StrokeDashArray="4,2" Fill="#30FFD54F" Visibility="Collapsed"/>
        </Canvas>
       </Grid>
       <Canvas x:Name="ViewerHudCanvas" IsHitTestVisible="False">
        <Border x:Name="SelectionInfoPopup" Visibility="Collapsed"
         Background="#F21B1E20" BorderBrush="#00E5FF" BorderThickness="1"
         CornerRadius="2" Padding="9,6" DataContext="{Binding SelectedObject}">
         <StackPanel>
          <TextBlock Foreground="White" FontWeight="SemiBold">
           <Run Text="Blob "/><Run Text="{Binding ObjectId}"/>
          </TextBlock>
          <TextBlock Foreground="#D8DDE0" FontSize="11">
           <Run Text="Area "/><Run Text="{Binding AreaPixel2, StringFormat=F2}"/><Run Text=" px²   "/>
           <Run Text="Eq.D "/><Run Text="{Binding EquivalentDiameterPixel, StringFormat=F2}"/><Run Text=" px"/>
          </TextBlock>
          <TextBlock Foreground="#D8DDE0" FontSize="11">
           <Run Text="Mean GV "/><Run Text="{Binding MeanGv, StringFormat=F1}"/><Run Text="   Accepted "/>
           <Run Text="{Binding FinalAccepted, Mode=OneWay}"/>
          </TextBlock>
         </StackPanel>
        </Border>
       </Canvas>
       <TextBlock Text="이미지를 열어주세요" Foreground="#A8ADB1" FontSize="15"
        HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
        Background="#D91B1E20" BorderBrush="#555A5E" BorderThickness="1" Padding="9,6"
        IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="●" Foreground="#46E669" Margin="0,0,4,0"/>
         <TextBlock Text="Accepted" Foreground="#E3E6E8" FontSize="11" Margin="0,0,10,0"/>
         <TextBlock Text="●" Foreground="#FF5F32" Margin="0,0,4,0"/>
         <TextBlock Text="Rejected" Foreground="#E3E6E8" FontSize="11" Margin="0,0,10,0"/>
         <TextBlock Text="□" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,4,0"/>
         <TextBlock Text="Selected" Foreground="#E3E6E8" FontSize="11"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
    </Grid>
   </Border>

   <Border Grid.Column="1" Grid.RowSpan="2" Margin="6,12,12,12" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
      CanContentScroll="True" Padding="0,0,0,8">
      <StackPanel Margin="12,12,12,4">
       <GroupBox Header="분석 ROI"
        ToolTip="실제로 분석할 사각 영역입니다. 이미지 위에서 드래그하거나 원본 이미지 기준 픽셀 좌표를 입력합니다. ROI 밖 픽셀은 분석하지 않습니다.">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <StackPanel Margin="0,0,5,6"><TextBlock Text="X" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Roi.X}" ToolTip="ROI 왼쪽 위 모서리의 원본 이미지 X 좌표(px)"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="5,0,0,6"><TextBlock Text="Y" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Roi.Y}" ToolTip="ROI 왼쪽 위 모서리의 원본 이미지 Y 좌표(px)"/></StackPanel>
         <StackPanel Grid.Row="1" Margin="0,0,5,0"><TextBlock Text="Width" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Roi.Width}" ToolTip="분석 ROI의 너비(px)"/></StackPanel>
         <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Height" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Roi.Height}" ToolTip="분석 ROI의 높이(px)"/></StackPanel>
        </Grid>
       </GroupBox>

       <GroupBox Header="Threshold / GV"
        ToolTip="Threshold는 픽셀을 전경/배경으로 나누는 1차 분할 조건입니다. 아래 객체 필터와는 별도로 적용됩니다.">
        <StackPanel>
         <TextBlock Text="방식" Foreground="{StaticResource Muted}"/>
         <ComboBox ItemsSource="{Binding ThresholdModes}" SelectedItem="{Binding Settings.ThresholdMode}" Margin="0,2,0,8"
          ToolTip="InRange: Min–Max GV 범위만 선택&#x0a;Binary: Min GV보다 밝은 픽셀 선택&#x0a;Otsu: 영상 분포에서 임계값을 자동 계산"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Minimum GV" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.MinimumGv}" ToolTip="전경으로 선택할 최소 Gray Value입니다. 8-bit 영상 기준 0은 검정, 255는 흰색입니다."/></StackPanel>
          <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Maximum GV" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.MaximumGv}" ToolTip="InRange 방식에서 전경으로 선택할 최대 Gray Value입니다."/></StackPanel>
         </Grid>
        </StackPanel>
       </GroupBox>

       <GroupBox Header="전처리"
        ToolTip="Threshold 적용 전에 영상 복사본을 보정합니다. 원본 이미지는 변경되지 않습니다.">
        <StackPanel>
         <CheckBox Content="Gaussian blur" IsChecked="{Binding Settings.Preprocessing.GaussianEnabled}" Margin="0,2,0,6"
          ToolTip="고주파 노이즈를 부드럽게 줄입니다. 작은 입자의 경계도 흐려질 수 있습니다."/>
         <Grid Margin="20,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
          <TextBlock Text="Kernel size" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding Settings.Preprocessing.GaussianKernelSize}" ToolTip="Blur 영역 크기입니다. 짝수를 입력하면 다음 홀수로 보정됩니다."/>
         </Grid>
         <CheckBox Content="CLAHE" IsChecked="{Binding Settings.Preprocessing.ClaheEnabled}" Margin="0,2,0,6"
          ToolTip="영역별 대비를 개선합니다. 조명이 불균일하거나 대비가 낮은 이미지에 유용합니다."/>
         <CheckBox Content="Invert" IsChecked="{Binding Settings.Preprocessing.Invert}" Margin="0,2,0,6"
          ToolTip="GV를 반전합니다. 어두운 입자를 밝은 전경으로 분석할 때 사용합니다."/>
         <CheckBox Content="Morphology open" IsChecked="{Binding Settings.Preprocessing.MorphologyOpenEnabled}" Margin="0,2,0,0"
          ToolTip="침식 후 팽창으로 작은 밝은 노이즈와 가는 돌기를 제거합니다."/>
        </StackPanel>
        </GroupBox>

        <GroupBox Header="접촉 입자 분리"
         ToolTip="붙어 있는 입자를 Distance Transform 기반 Watershed로 분리합니다. 과분할될 수 있으므로 Binary mask와 결과를 함께 확인하세요.">
         <StackPanel>
          <CheckBox Content="Watershed 사용" IsChecked="{Binding Settings.Watershed.Enabled}" Margin="0,0,0,7"/>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
           <TextBlock Text="Seed threshold ratio" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
           <TextBox Grid.Column="1" Text="{Binding Settings.Watershed.SeedThresholdRatio}"
            ToolTip="Distance Transform 최대값 대비 seed 임계 비율입니다. 낮추면 분리 seed가 커지고 높이면 보수적으로 분리합니다."/>
          </Grid>
          <Grid Margin="0,6,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
           <TextBlock Text="Minimum peak distance" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
           <TextBox Grid.Column="1" Text="{Binding Settings.Watershed.MinimumPeakDistance}"
            ToolTip="서로 다른 입자 중심 peak 사이의 최소 거리(px)입니다. 너무 작으면 과분할될 수 있습니다."/>
          </Grid>
         </StackPanel>
        </GroupBox>

        <GroupBox Header="객체 필터"
        ToolTip="Threshold로 분할된 각 객체의 측정값을 검사합니다. 활성화한 모든 필터를 통과해야 Accepted가 됩니다.">
        <StackPanel>
         <CheckBox Content="Area 활성화" IsChecked="{Binding Settings.AreaFilter.Enabled}" Margin="0,0,0,5"
          ToolTip="객체 내부 픽셀 면적으로 통과 여부를 판정합니다."/>
         <Grid Margin="20,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Min px²" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.AreaFilter.Minimum}" ToolTip="이 면적보다 작은 객체를 제외합니다. 빈 값은 하한 없음입니다."/></StackPanel>
          <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Max px²" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.AreaFilter.Maximum}" ToolTip="이 면적보다 큰 객체를 제외합니다. 빈 값은 상한 없음입니다."/></StackPanel>
          </Grid>
          <CheckBox Content="Max Feret 활성화" IsChecked="{Binding Settings.MaxFeretFilter.Enabled}" Margin="0,0,0,5"
           ToolTip="객체 윤곽의 두 점 사이 최대 거리로 크기를 필터링합니다."/>
          <Grid Margin="20,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <TextBox Text="{Binding Settings.MaxFeretFilter.Minimum}" Margin="0,0,5,0" ToolTip="최소 Max Feret (px)"/>
           <TextBox Grid.Column="1" Text="{Binding Settings.MaxFeretFilter.Maximum}" Margin="5,0,0,0" ToolTip="최대 Max Feret (px)"/>
          </Grid>
         <CheckBox Content="Circularity 활성화" IsChecked="{Binding Settings.CircularityFilter.Enabled}" Margin="0,0,0,5"
          ToolTip="Circularity = 4π × Area / Perimeter². 원에 가까울수록 1에 가깝습니다. 매우 작은 객체는 값이 불안정하여 계산하지 않을 수 있습니다."/>
         <Grid Margin="20,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Settings.CircularityFilter.Minimum}" Margin="0,0,5,0"/>
          <TextBox Grid.Column="1" Text="{Binding Settings.CircularityFilter.Maximum}" Margin="5,0,0,0"/>
         </Grid>
         <TextBlock Text="ROI 경계 객체" Foreground="{StaticResource Muted}"/>
         <ComboBox ItemsSource="{Binding BorderRules}" SelectedItem="{Binding Settings.BorderRule}" Margin="0,3,0,0"
          ToolTip="Include: 경계 객체 포함&#x0a;Exclude: 잘렸을 가능성이 있는 경계 객체 제외&#x0a;Mark: 포함하되 TouchesBorder로 표시"/>
        </StackPanel>
       </GroupBox>

       <GroupBox Header="Scale calibration"
        ToolTip="이미지 전체의 실제 너비 또는 높이를 입력해 µm/pixel을 계산합니다. 보정이 없으면 실제 단위 측정값은 저장되지 않습니다.">
        <StackPanel>
         <CheckBox Content="보정값 사용" IsChecked="{Binding Settings.Calibration.Enabled}" Margin="0,0,0,7"
          ToolTip="켜면 µm/pixel 값으로 면적과 직경을 실제 단위로 환산합니다."/>
         <TextBlock Text="입력 단위" Foreground="{StaticResource Muted}"/>
         <ComboBox ItemsSource="{Binding LengthUnits}" SelectedItem="{Binding Settings.Calibration.InputUnit}" Margin="0,2,0,7"
          ToolTip="실제 이미지 크기에 사용할 길이 단위입니다. 결과 환산값은 µm/pixel로 통일해 저장됩니다."/>
         <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="실제 이미지 너비" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Calibration.ActualImageWidth, TargetNullValue=''}" ToolTip="원본 이미지 전체 너비가 나타내는 실제 길이입니다. 너비와 높이 중 하나만 입력해도 됩니다."/></StackPanel>
          <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="실제 이미지 높이" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.Calibration.ActualImageHeight, TargetNullValue=''}" ToolTip="원본 이미지 전체 높이가 나타내는 실제 길이입니다. 두 축을 모두 입력하면 축척 일치 여부를 검사합니다."/></StackPanel>
         </Grid>
         <Button Content="보정값 계산" Command="{Binding CalculateScaleCommand}" Margin="0,0,0,7"
          ToolTip="실제 이미지 크기 ÷ 픽셀 크기로 µm/pixel을 계산하고 보정값 사용을 켭니다."/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="계산된 축척" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding Settings.Calibration.MicrometersPerPixel, StringFormat=G8}"
           IsReadOnly="True" ToolTip="픽셀 1개가 나타내는 실제 길이입니다. 모든 실제 단위 측정의 기준값입니다."/>
         </Grid>
        </StackPanel>
       </GroupBox>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="{StaticResource Line}"
      BorderThickness="0,1,0,0" Padding="12,10">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
        <Button Command="{Binding AnalyzeCommand}" Margin="0"
         ToolTip="현재 ROI와 모든 활성 조건을 적용하여 입자를 다시 검출하고 측정합니다.">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,7,0"/>
          <TextBlock Text="분석 실행" FontWeight="SemiBold"/>
         </StackPanel>
        </Button>
        <Button Grid.Column="1" Command="{Binding CancelCommand}" Margin="8,0,0,0"
         ToolTip="현재 진행 중인 이미지 로드 또는 분석 작업을 안전하게 취소합니다.">
         <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;"/>
        </Button>
      </Grid>
     </Border>
    </Grid>
   </Border>

   <Border Grid.Column="0" Grid.Row="1" Margin="12,6,6,12" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Padding="12,9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="선택 객체 포함/제외" Command="{Binding ToggleObjectCommand}" Padding="10,4"
        ToolTip="DataGrid에서 선택한 객체의 자동 판정을 수동으로 뒤집습니다."/>
       <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid>
       <TextBlock Text="이미지의 검출 영역 또는 아래 행을 클릭하면 상세 측정값이 표시됩니다."
        Foreground="{StaticResource Muted}" VerticalAlignment="Center">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Style.Triggers>
           <DataTrigger Binding="{Binding SelectedObject}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed"/>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Grid DataContext="{Binding SelectedObject}">
        <Grid.Style>
         <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/>
         <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="85"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="OBJECT" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding ObjectId, StringFormat=ID {0}}" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="JUDGEMENT" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding FinalAccepted, Mode=OneWay, StringFormat=Accepted: {0}}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="CENTROID (PX)" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock><Run Text="{Binding CentroidXPixel, StringFormat=F1}"/><Run Text=", "/><Run Text="{Binding CentroidYPixel, StringFormat=F1}"/></TextBlock></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="AREA (PX²)" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding AreaPixel2, StringFormat=F2}"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="AREA (µm²)" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding AreaUm2, TargetNullValue=-, StringFormat=F3}"/></StackPanel>
        <StackPanel Grid.Column="5"><TextBlock Text="EQ.DIA (µm)" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding EquivalentDiameterUm, TargetNullValue=-, StringFormat=F3}"/></StackPanel>
        <StackPanel Grid.Column="6"><TextBlock Text="MEAN GV" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding MeanGv, StringFormat=F1}"/></StackPanel>
        <StackPanel Grid.Column="7"><TextBlock Text="REJECTED BY" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding RejectionSummary, TargetNullValue=-}" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid>
      </Grid>
     </Border>
      <TabControl Grid.Row="2" BorderThickness="0">
       <TabItem Header="측정 데이터">
      <DataGrid x:Name="ObjectDataGrid" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
      AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="ID" Binding="{Binding ObjectId}" Width="55"/>
       <DataGridCheckBoxColumn Header="Accepted" Binding="{Binding FinalAccepted, Mode=OneWay}" Width="75"/>
       <DataGridTextColumn Header="Area (px²)" Binding="{Binding AreaPixel2, StringFormat=F2}" Width="90">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="객체 contour 내부의 면적(pixel²)"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Eq. diameter (px)" Binding="{Binding EquivalentDiameterPixel, StringFormat=F2}" Width="110">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="동일한 면적을 가진 원의 직경: 2 × sqrt(Area / π)"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Area (µm²)" Binding="{Binding AreaUm2, StringFormat=F3, TargetNullValue=-}" Width="90">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="Scale calibration이 적용된 실제 객체 면적"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
        <DataGridTextColumn Header="Eq. diameter (µm)" Binding="{Binding EquivalentDiameterUm, StringFormat=F3, TargetNullValue=-}" Width="110">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="Scale calibration이 적용된 실제 등가원 직경"/></Style></DataGridTextColumn.HeaderStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Max Feret (px)" Binding="{Binding MaxFeretPixel, StringFormat=F2, TargetNullValue=-}" Width="105"/>
        <DataGridTextColumn Header="Min Feret (px)" Binding="{Binding MinFeretPixel, StringFormat=F2, TargetNullValue=-}" Width="105"/>
        <DataGridTextColumn Header="Major axis (px)" Binding="{Binding MajorAxisPixel, StringFormat=F2, TargetNullValue=-}" Width="105"/>
        <DataGridTextColumn Header="Minor axis (px)" Binding="{Binding MinorAxisPixel, StringFormat=F2, TargetNullValue=-}" Width="105"/>
        <DataGridTextColumn Header="Aspect ratio" Binding="{Binding AspectRatio, StringFormat=F3, TargetNullValue=-}" Width="90"/>
        <DataGridTextColumn Header="Orientation (°)" Binding="{Binding OrientationDegrees, StringFormat=F1, TargetNullValue=-}" Width="100"/>
       <DataGridTextColumn Header="Perimeter (px)" Binding="{Binding PerimeterPixel, StringFormat=F2}" Width="100">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="객체 contour를 따라 측정한 둘레(pixel)"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Circularity" Binding="{Binding Circularity, StringFormat=F3}" Width="85">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="4π × Area / Perimeter². 원에 가까울수록 1에 가까움"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Solidity" Binding="{Binding Solidity, StringFormat=F3}" Width="80">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="Area / ConvexHullArea. 오목함이 적을수록 1에 가까움"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Mean GV" Binding="{Binding MeanGv, StringFormat=F1}" Width="80">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="객체 내부 픽셀의 평균 Gray Value"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
       <DataGridCheckBoxColumn Header="Border" Binding="{Binding TouchesBorder}" Width="65">
        <DataGridCheckBoxColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="객체가 분석 ROI 경계에 닿았는지 여부"/></Style></DataGridCheckBoxColumn.HeaderStyle>
       </DataGridCheckBoxColumn>
       <DataGridTextColumn Header="Rejected by" Binding="{Binding RejectionSummary}" Width="*">
        <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="ToolTip" Value="자동 판정에서 객체를 제외한 조건 목록"/></Style></DataGridTextColumn.HeaderStyle>
       </DataGridTextColumn>
      </DataGrid.Columns>
      </DataGrid>
       </TabItem>
       <TabItem Header="크기 분포">
        <Grid Margin="14">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="Accepted 객체 · Equivalent diameter (px)" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <controls:HistogramChart Grid.Row="1" ItemsSource="{Binding DiameterHistogram}" MinHeight="150"/>
         <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <TextBlock Text="D10 " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Summary.D10Pixel, StringFormat=F2, TargetNullValue=-}" FontWeight="SemiBold" Margin="0,0,18,0"/>
          <TextBlock Text="D50 " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Summary.D50Pixel, StringFormat=F2, TargetNullValue=-}" FontWeight="SemiBold" Margin="0,0,18,0"/>
          <TextBlock Text="D90 " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Summary.D90Pixel, StringFormat=F2, TargetNullValue=-}" FontWeight="SemiBold"/>
         </StackPanel>
        </Grid>
       </TabItem>
      </TabControl>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="2" Background="#F7F8F9" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,0">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text=".NET 10  ·  OpenCvSharp  ·  v0.1.0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
